---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, serviceKeywordPlural, city, region, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides garage door spring, opener, and panel repair in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} repairs garage doors in Florence, Covington, Fort Thomas, Newport, and across ${region}: springs, openers, panels, and tracks on all major brands. Free quotes.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Garage door repair for Northern Kentucky homes and businesses.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt={`${businessName} team`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- About content -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>{businessName} provides {serviceKeywordPlural} for homes and businesses across {region}: broken springs, openers that won't run, dented or rusted panels, and doors that have come off their tracks.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <img
    src="/photos/residential.jpg"
    alt={`${serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} in ${city}`}
    class="site-photo mx-auto max-w-lg my-6"
    loading="lazy"
  />

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Repair Works</h2>

  <p><strong>1. Call.</strong> Call {phone} or send the form. Tell us what the door is doing — won't open, loud noises, a gap in the spring, a door hanging crooked — and we'll give you a free quote.</p>

  <p><strong>2. Repair.</strong> We carry common spring sizes and opener parts, so most repairs are finished in a single visit. You get the price before any work starts.</p>

  <p><strong>3. Test.</strong> Before we leave, we run the door through several cycles with you and check that the safety reverse works.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/garage-door/${c.slug}/`}>Garage door repair in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask.</p>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Need Garage Door Repair?</p>
    <p class="cta-sub">Call now for a free quote.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>

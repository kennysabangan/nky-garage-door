---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import { siteConfig } from '../../config';

const { businessName, phone, phoneE164, siteUrl, serviceKeyword, serviceKeywordPlural, city, region, services, cities } = siteConfig;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase()),
  "provider": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": phoneE164,
  },
  "areaServed": siteConfig.cities.map((c) => ({ "@type": "City", "name": c.name })),
  "description": `Professional ${serviceKeywordPlural} for residential and commercial properties in ${city}.`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/garage-door/` },
  ],
};
---

<BaseLayout
  title={`Garage Door Repair Service Areas in Northern Kentucky | ${businessName}`}
  description={`${serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} services in ${city}. We provide ${serviceKeywordPlural} on homes, offices, and commercial buildings across ${region}. Call ${phone} for a free estimate.`}
  canonicalURL={`${siteUrl}/garage-door/`}
  schema={[breadcrumbSchema, serviceSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>{serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Services in {city}</h1>
    <p class="hero-sub">Residential {serviceKeyword}, commercial {serviceKeyword}, and more. Serving all of {region}.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/hero.jpg"
    alt={`${serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} services in ${city}`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- Services -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">Our {serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Services</h2>

  <p>{businessName} provides professional {serviceKeywordPlural} throughout {city}. We repair garage doors on homes, offices, and commercial buildings. Here are the {serviceKeywordPlural} we offer:</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-8">
    {services.map((service) => (
      <div class="service-card">
        <img src={service.photo} alt={`${service.title} — ${businessName}`} loading="lazy" />
        <div class="card-body">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How Our {serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Service Works</h2>

  <p>Getting your garage door repaired by {businessName} is easy. Here's how it works:</p>

  <p><strong>Step 1: Call Us.</strong> Give us a call at {phone} and describe your garage door problem. We'll ask what's happening — won't open, loud noises, broken spring, stuck door — and give you a free quote.</p>

  <p><strong>Step 2: Get Your Free Estimate.</strong> We'll give you a clear, upfront price for your {serviceKeyword}. No hidden fees, no surprises.</p>

  <p><strong>Step 3: We Fix Your Door.</strong> Our technician arrives with common springs and opener parts on hand, so most repairs are completed in a single visit. We work efficiently and treat your property with respect.</p>

  <p><strong>Step 4: Test and Walk-Through.</strong> Before we leave, we run the door through several open-and-close cycles with you and check that the safety reverse works.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">{serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Service Areas</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/garage-door/${c.slug}/`}>{serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} in {c.name}</a></li>
    ))}
  </ul>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Need Garage Door Repair?</p>
    <p class="cta-sub">Call now for a free {serviceKeyword} estimate in {city}.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Final CTA -->
<section class="bg-brand-dark text-white">
  <div class="cta-strip container">
    <h2 class="text-white text-xl md:text-2xl font-bold mb-2">Call Now for {serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} in {city}</h2>
    <p class="text-white/90 text-base mb-4">We provide {serviceKeywordPlural} across {region}.</p>
    <PhoneCTA label="Call Now" />
  </div>
</section>

</BaseLayout>
